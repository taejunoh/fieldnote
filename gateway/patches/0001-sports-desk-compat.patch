+func TestSportsDeskEffortAndLiveSearch(t *testing.T) {
+	for _, effort := range []string{"medium", "high", "xhigh"} {
+		in := []byte(`{"model":"gpt-6-astra","reasoning_effort":"` + effort + `","messages":[{"role":"user","content":"latest score"}],"tools":[{"type":"function","function":{"name":"web_search"}}],"tool_choice":"required","llms":{"web_search":{"mode":"live"}}}`)
+		out, _, _, err := chatToCodexResponses(in)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var parsed map[string]any
+		if err := json.Unmarshal(out, &parsed); err != nil {
+			t.Fatal(err)
+		}
+		reasoning, _ := parsed["reasoning"].(map[string]any)
+		if reasoning["effort"] != effort {
+			t.Fatalf("effort %q: %s", effort, out)
+		}
+		include, _ := parsed["include"].([]any)
+		if len(include) != 1 || include[0] != "web_search_call.action.sources" {
+			t.Fatalf("search source inclusion: %s", out)
+		}
+		tools, _ := parsed["tools"].([]any)
+		if len(tools) != 1 || tools[0].(map[string]any)["external_web_access"] != true {
+			t.Fatalf("live search: %s", out)
