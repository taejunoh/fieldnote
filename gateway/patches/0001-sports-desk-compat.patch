+	"github.com/goodtekxyz/openllms/internal/proxy"
+	"github.com/goodtekxyz/openllms/internal/secrets"
+	"github.com/goodtekxyz/openllms/internal/secrets/memory"
+	"github.com/goodtekxyz/openllms/internal/store"
+	"github.com/goodtekxyz/openllms/internal/vendor"
+	"github.com/goodtekxyz/openllms/internal/vendorauth"
+	"github.com/google/uuid"
+)
+
+func TestSportsDeskExplicitHTTPRecoveryUsesSameCodexAccount(t *testing.T) {
+	var handshakes, creates, httpPosts atomic.Int32
+	var wsCreate, httpRequestBody map[string]any
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/responses" {
+			http.NotFound(w, r)
+			return
+		}
+		if r.Header.Get("Authorization") != "Bearer recovery-test-token" || r.Header.Get("ChatGPT-Account-Id") != "recovery-account" {
+			t.Errorf("upstream identity changed: authorization=%t account=%q", r.Header.Get("Authorization") == "Bearer recovery-test-token", r.Header.Get("ChatGPT-Account-Id"))
+		}
+		if r.Method == http.MethodGet {
+			handshakes.Add(1)
+			w.Header().Set("X-Request-Id", "req_ws_recovery")
+			conn, err := websocket.Accept(w, r, nil)
+			if err != nil {
+				t.Errorf("accept websocket: %v", err)
+				return
+			}
+			defer conn.CloseNow()
+			ctx, cancel := context.WithTimeout(r.Context(), time.Second)
+			defer cancel()
+			_, payload, err := conn.Read(ctx)
+			if err != nil {
+				t.Errorf("read create: %v", err)
+				return
+			}
+			creates.Add(1)
+			var create map[string]any
+			if json.Unmarshal(payload, &create) != nil || create["type"] != "response.create" || create["reasoning"].(map[string]any)["effort"] != "xhigh" || !strings.Contains(string(payload), "recovery-full-input") {
+				t.Errorf("unexpected WS create: %s", payload)
+			}
+			wsCreate = create
+			_ = conn.Write(ctx, websocket.MessageText, []byte(`{"type":"response.created","response":{"id":"resp_ws_recovery"}}`))
+			_ = conn.Write(ctx, websocket.MessageText, []byte(`{"type":"response.output_text.delta","delta":"partial-only"}`))
+			// An abrupt connection loss after create reproduces an interrupted first generation.
+			return
+		}
+
+		httpPosts.Add(1)
+		if r.Method != http.MethodPost || r.Header.Get("Accept") != "text/event-stream" {
+			t.Errorf("recovery did not use Responses HTTP/SSE: method=%s accept=%q", r.Method, r.Header.Get("Accept"))
+		}
+		var body map[string]any
+		if json.NewDecoder(r.Body).Decode(&body) != nil || body["model"] != "gpt-6-astra" || body["reasoning"].(map[string]any)["effort"] != "xhigh" || !strings.Contains(mustJSON(body), "recovery-full-input") {
+			t.Errorf("HTTP recovery request semantics changed: %v", body)
+		}
+		httpRequestBody = body
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.Header().Set("X-Request-Id", "req_http_recovery")
+		w.WriteHeader(http.StatusOK)
+		_, _ = io.WriteString(w, "data: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"web_search_call\",\"status\":\"completed\",\"action\":{\"type\":\"search\",\"sources\":[{\"url\":\"https://example.org/recovery-source\"}]}}}\n\n")
+		_, _ = io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_http_recovery\",\"output\":[{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"verified-final\"}]}]}}\n\n")
+	}))
+	defer up.Close()
+
+	sec := memory.New()
+	accountID := uuid.New()
+	path := vendor.InfisicalPath(uuid.New().String(), "codex", "recovery")
+	if err := sec.Put(context.Background(), path, vendor.SecretName, mustJSON(secrets.CredentialJSON{AccessToken: "recovery-test-token", ChatGPTAccountID: "recovery-account"})); err != nil {
+		t.Fatal(err)
+	}
+	acc := &store.Account{ID: accountID, Vendor: "codex", AuthType: "oauth", InfisicalPath: path, BaseURL: up.URL}
+	client := up.Client()
+	client.Timeout = time.Second
+	eng := &proxy.Engine{Secrets: sec, HTTP: client}
+	eng.CodexTransport = "ws"
+	requestBody := []byte(`{"model":"gpt-6-astra","reasoning_effort":"xhigh","stream":true,"messages":[{"role":"user","content":"recovery-full-input"}],"tools":[{"type":"function","function":{"name":"web_search"}}],"tool_choice":"required","llms":{"web_search":{"mode":"live"}}}`)
+
+	first, err := eng.CallAccountForTest(context.Background(), acc, requestBody)
+	if err != nil {
+		t.Fatal(err)
+	}
+	firstBody, err := io.ReadAll(first.Stream)
+	first.Stream.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(firstBody), "interrupted") || !strings.Contains(string(firstBody), "partial-only") {
+		t.Fatalf("first WS terminal did not preserve its partial interruption: %s", firstBody)
+	}
+
+	gatewayRequestID := uuid.NewString()
+	recoveryCtx := proxy.WithGatewayRequestID(context.Background(), gatewayRequestID)
+	recoveryCtx = proxy.WithCodexHTTPRecovery(recoveryCtx, accountID)
+	second, err := eng.CallAccountForTest(recoveryCtx, acc, requestBody)
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondBody, err := io.ReadAll(second.Stream)
+	second.Stream.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if handshakes.Load() != 1 || creates.Load() != 1 || httpPosts.Load() != 1 {
+		t.Fatalf("recovery call counts: ws_handshakes=%d ws_creates=%d http_posts=%d", handshakes.Load(), creates.Load(), httpPosts.Load())
+	}
+	delete(wsCreate, "type")
+	if !reflect.DeepEqual(wsCreate, httpRequestBody) {
+		t.Fatalf("recovery input diverged from the first create: ws=%s http=%s", mustJSON(wsCreate), mustJSON(httpRequestBody))
+	}
+	if !strings.Contains(string(secondBody), "verified-final") || !strings.Contains(string(secondBody), "https://example.org/recovery-source") || strings.Contains(string(secondBody), "partial-only") || !strings.Contains(string(secondBody), `"upstream_transport":"http"`) || !strings.Contains(string(secondBody), `"upstream_http_status":200`) || !strings.Contains(string(secondBody), `"gateway_request_id":"`+gatewayRequestID+`"`) || !strings.Contains(string(secondBody), "req_http_recovery") {
+		t.Fatalf("HTTP recovery terminal lost completion or safe diagnostics: %s", secondBody)
+	}
+
+	handshakes.Store(0)
+	creates.Store(0)
+	httpPosts.Store(0)
+	type callResult struct {
+		body []byte
+		err  error
+	}
+	results := make(chan callResult, 2)
+	go func() {
+		res, callErr := eng.CallAccountForTest(context.Background(), acc, requestBody)
+		if callErr != nil || res == nil || res.Stream == nil {
+			results <- callResult{err: callErr}
+			return
+		}
+		body, readErr := io.ReadAll(res.Stream)
+		res.Stream.Close()
+		results <- callResult{body: body, err: readErr}
+	}()
+	go func() {
+		ctx := proxy.WithCodexHTTPRecovery(context.Background(), accountID)
+		res, callErr := eng.CallAccountForTest(ctx, acc, requestBody)
+		if callErr != nil || res == nil || res.Stream == nil {
+			results <- callResult{err: callErr}
+			return
+		}
+		body, readErr := io.ReadAll(res.Stream)
+		res.Stream.Close()
+		results <- callResult{body: body, err: readErr}
+	}()
+	var concurrent []string
+	for i := 0; i < 2; i++ {
+		result := <-results
+		if result.err != nil {
+			t.Fatal(result.err)
+		}
+		concurrent = append(concurrent, string(result.body))
+	}
+	if handshakes.Load() != 1 || creates.Load() != 1 || httpPosts.Load() != 1 {
+		t.Fatalf("concurrent request-local transports leaked: ws_handshakes=%d ws_creates=%d http_posts=%d", handshakes.Load(), creates.Load(), httpPosts.Load())
+	}
+	hasPartial, hasHTTPFinal := false, false
+	for _, body := range concurrent {
+		hasPartial = hasPartial || strings.Contains(body, "partial-only")
+		hasHTTPFinal = hasHTTPFinal || strings.Contains(body, "verified-final")
+	}
+	if !hasPartial || !hasHTTPFinal {
+		t.Fatalf("concurrent calls did not retain distinct transport outcomes: %q", concurrent)
+	}
+}
+
+func TestSportsDeskHTTPRecoveryPinsAttachedAccountAndSuppressesFallback(t *testing.T) {
+	var pinnedCalls, alternateCalls atomic.Int32
+	var refreshCalls atomic.Int32
+	previousRefreshClient := vendorauth.HTTPClient
+	t.Cleanup(func() { vendorauth.HTTPClient = previousRefreshClient })
+	vendorauth.HTTPClient = &http.Client{Transport: recoveryRoundTripper(func(r *http.Request) (*http.Response, error) {
+		refreshCalls.Add(1)
+		return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"access_token":"unexpected-refresh"}`)), Request: r}, nil
+	})}
+	pinnedUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		pinnedCalls.Add(1)
+		if r.Method != http.MethodPost || r.Header.Get("Authorization") != "Bearer pinned-token" {
+			t.Errorf("pinned account request mismatch: method=%s", r.Method)
+		}
+		var body struct {
+			Model string `json:"model"`
+		}
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		switch body.Model {
+		case "failure-401":
+			w.WriteHeader(http.StatusUnauthorized)
+		case "failure-500":
+			w.WriteHeader(http.StatusInternalServerError)
+		case "failure-read-eof":
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = io.WriteString(w, "data: {\"type\":\"response.output_text.delta\",\"delta\":\"partial\"}\n\n")
+		default:
+			w.WriteHeader(http.StatusTooManyRequests)
+		}
+	}))
+	defer pinnedUpstream.Close()
+	alternateUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		alternateCalls.Add(1)
+		w.WriteHeader(http.StatusOK)
+		_, _ = io.WriteString(w, `{"choices":[{"message":{"role":"assistant","content":"wrong-account"}}]}`)
+	}))
+	defer alternateUpstream.Close()
+
+	sec := memory.New()
+	pinnedID, alternateID := uuid.New(), uuid.New()
+	pinnedPath := vendor.InfisicalPath(uuid.New().String(), "codex", "pinned")
+	alternatePath := vendor.InfisicalPath(uuid.New().String(), "openai", "paid-alternate")
+	if err := sec.Put(context.Background(), pinnedPath, vendor.SecretName, mustJSON(secrets.CredentialJSON{AccessToken: "pinned-token", RefreshToken: "must-not-refresh", ChatGPTAccountID: "pinned-chatgpt-account"})); err != nil {
+		t.Fatal(err)
+	}
+	if err := sec.Put(context.Background(), alternatePath, vendor.SecretName, mustJSON(secrets.CredentialJSON{APIKey: "alternate-paid-key"})); err != nil {
+		t.Fatal(err)
+	}
+	routeID := uuid.New()
+	fallbackID := uuid.New()
+	pinned := store.Account{ID: pinnedID, Vendor: "codex", AuthType: "oauth", InfisicalPath: pinnedPath, BaseURL: pinnedUpstream.URL}
+	alternate := store.Account{ID: alternateID, Vendor: "openai", AuthType: "api_key", InfisicalPath: alternatePath, BaseURL: alternateUpstream.URL + "/v1"}
+	fallbackRoute := &store.Route{ID: fallbackID, Strategy: "sequential"}
+	st := &memRouteStore{
+		accounts: []store.Account{alternate, pinned},
+		cool:     map[uuid.UUID]time.Time{},
+		routes:   map[string]*store.Route{"paid-fallback": fallbackRoute},
+	}
+	eng := &proxy.Engine{Store: st, Secrets: sec, HTTP: &http.Client{Timeout: time.Second}, Selector: nil, CodexTransport: "ws"}
+	rt := &store.Route{ID: routeID, Strategy: "parallel", Config: []byte(`{"parallel_allow_oauth":true,"fallback_slugs":["paid-fallback"]}`)}
+	st.byRoute = map[uuid.UUID][]store.Account{
+		routeID:    {alternate, pinned},
+		fallbackID: {alternate},
+	}
+	ctx := proxy.WithCodexHTTPRecovery(context.Background(), pinnedID)
+	res, err := eng.ChatCompletions(ctx, uuid.New(), rt, []byte(`{"model":"gpt-6-astra","stream":true,"messages":[{"role":"user","content":"same full request"}]}`), proxy.DispatchMeta{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if pinnedCalls.Load() != 1 || alternateCalls.Load() != 0 || res.AccountID != pinnedID || res.StatusCode != http.StatusTooManyRequests || res.Attempts != 1 || res.Strategy != "sequential" {
+		t.Fatalf("recovery escaped pinned single-account dispatch: pinned=%d alternate=%d account=%s status=%d attempts=%d strategy=%s", pinnedCalls.Load(), alternateCalls.Load(), res.AccountID, res.StatusCode, res.Attempts, res.Strategy)
+	}
+
+	missingCtx := proxy.WithCodexHTTPRecovery(context.Background(), uuid.New())
+	missing, err := eng.ChatCompletions(missingCtx, uuid.New(), rt, []byte(`{"model":"gpt-6-astra","messages":[]}`), proxy.DispatchMeta{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if missing.StatusCode != http.StatusConflict || missing.Error != "transport_recovery_account_unavailable" || pinnedCalls.Load() != 1 || alternateCalls.Load() != 0 {
+		t.Fatalf("missing pin did not fail closed: status=%d error=%q pinned=%d alternate=%d", missing.StatusCode, missing.Error, pinnedCalls.Load(), alternateCalls.Load())
+	}
+
+	for _, model := range []string{"failure-401", "failure-500", "failure-read-eof"} {
+		beforeCalls := pinnedCalls.Load()
+		body := []byte(`{"model":"` + model + `","stream":true,"messages":[{"role":"user","content":"same full request"}]}`)
+		failed, err := eng.ChatCompletions(ctx, uuid.New(), rt, body, proxy.DispatchMeta{})
+		if err != nil {
+			t.Fatalf("%s: %v", model, err)
+		}
+		if failed.Stream != nil {
+			streamBody, readErr := io.ReadAll(failed.Stream)
+			failed.Stream.Close()
+			if readErr != nil {
+				t.Fatalf("%s stream read: %v", model, readErr)
+			}
+			if model == "failure-read-eof" && !strings.Contains(string(streamBody), `"upstream_terminal_status":"interrupted"`) {
+				t.Fatalf("read EOF terminal missing: %s", streamBody)
+			}
+		}
+		if pinnedCalls.Load() != beforeCalls+1 || alternateCalls.Load() != 0 || refreshCalls.Load() != 0 || failed.AccountID != pinnedID || failed.Attempts != 1 {
+			t.Fatalf("%s recovery replayed or failed over: pinned=%d alternate=%d refresh=%d account=%s attempts=%d", model, pinnedCalls.Load()-beforeCalls, alternateCalls.Load(), refreshCalls.Load(), failed.AccountID, failed.Attempts)
+		}
+	}
+}
+
+type recoveryRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f recoveryRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
