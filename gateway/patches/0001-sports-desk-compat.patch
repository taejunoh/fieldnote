+func TestSportsDeskUpstreamTimeoutConfiguration(t *testing.T) {
+	t.Setenv("DATABASE_URL", "sqlite:///tmp/config-only.db")
+	for _, tc := range []struct {
+		raw     string
+		seconds int
+		invalid bool
+	}{
+		{"", 2700, false}, {"60", 60, false}, {"3600", 3600, false}, {"59", 0, true}, {"3601", 0, true}, {"0", 0, true}, {"-1", 0, true}, {"2700junk", 0, true}, {"secret-invalid", 0, true}, {" 60", 0, true},
+	} {
+		t.Run(tc.raw, func(t *testing.T) {
+			t.Setenv("OPENLLMS_UPSTREAM_TIMEOUT_SECONDS", tc.raw)
+			cfg, err := config.Load()
+			if tc.invalid {
+				if err == nil {
+					t.Fatal("invalid timeout accepted")
+				}
+				if err.Error() != "OPENLLMS_UPSTREAM_TIMEOUT_SECONDS must be an integer from 60 to 3600" {
+					t.Fatal("raw configuration echoed")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := time.Duration(tc.seconds) * time.Second
+			if cfg.UpstreamTimeout != want || New(&store.Store{}, cfg, nil).proxy.HTTP.Timeout != want {
+				t.Fatalf("timeout not configured: %s", cfg.UpstreamTimeout)
+			}
+		})
+	}
+}
