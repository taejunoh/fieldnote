+	t.Setenv("DATABASE_URL", "sqlite:///tmp/config-only.db")
+	for _, tc := range []struct{ raw, want string }{{"", "http"}, {"http", "http"}, {"ws", "ws"}, {"WS", ""}, {" ws", ""}, {"secret-invalid", ""}} {
+		t.Run(tc.raw, func(t *testing.T) {
+			t.Setenv("OPENLLMS_CODEX_TRANSPORT", tc.raw)
