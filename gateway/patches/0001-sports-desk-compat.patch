diff --git a/internal/httpserver/diagnostics.go b/internal/httpserver/diagnostics.go
new file mode 100644
index 0000000..6288463
--- /dev/null
+++ b/internal/httpserver/diagnostics.go
@@ -0,0 +1,178 @@
+package httpserver
+
+import (
+	"errors"
+	"log/slog"
+	"net/http"
+	"os"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+const (
+	headerJobID             = "X-SportsDesk-Job-Id"
+	headerAttemptID         = "X-SportsDesk-Attempt-Id"
+	headerTransportAttempt  = "X-SportsDesk-Transport-Attempt"
+	headerRequestID         = "X-SportsDesk-Request-Id"
+	headerGatewayRequestID  = "X-SportsDesk-Gateway-Request-Id"
+	headerUpstreamTransport = "X-SportsDesk-Upstream-Transport"
+	headerRecoveryAccountID = "X-SportsDesk-Recovery-Account-Id"
+)
+
+var buildIDPattern = regexp.MustCompile(`^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$`)
+
+var gatewayInstanceID = uuid.NewString()
+
+func parseCodexHTTPRecovery(r *http.Request, configuredTransport string) (uuid.UUID, bool, bool) {
+	transportValues := r.Header.Values(headerUpstreamTransport)
+	accountValues := r.Header.Values(headerRecoveryAccountID)
+	if len(transportValues) == 0 && len(accountValues) == 0 {
+		return uuid.Nil, false, true
+	}
+	attemptValues := r.Header.Values(headerTransportAttempt)
+	if len(transportValues) != 1 || len(accountValues) != 1 || len(attemptValues) != 1 || transportValues[0] != "http" || configuredTransport != "ws" || attemptValues[0] != "2" {
+		return uuid.Nil, false, false
+	}
+	for _, name := range []string{headerJobID, headerAttemptID, headerRequestID} {
+		values := r.Header.Values(name)
+		if len(values) != 1 {
+			return uuid.Nil, false, false
+		}
+		id, err := uuid.Parse(values[0])
+		if err != nil || strings.ToLower(values[0]) != id.String() {
+			return uuid.Nil, false, false
+		}
+	}
+	accountID, err := uuid.Parse(accountValues[0])
+	if err != nil || accountID == uuid.Nil || strings.ToLower(accountValues[0]) != accountID.String() {
+		return uuid.Nil, false, false
+	}
+	return accountID, true, true
+}
+
+type gatewayResponseWriter struct {
+	http.ResponseWriter
+	status          int
+	writeFailed     bool
+	deliveryUnknown bool
+}
+
+func (w *gatewayResponseWriter) WriteHeader(status int) {
+	if w.status != 0 {
+		return
+	}
+	w.status = status
+	w.ResponseWriter.WriteHeader(status)
+}
+
+func (w *gatewayResponseWriter) Write(p []byte) (int, error) {
+	if w.status == 0 {
+		w.WriteHeader(http.StatusOK)
+	}
+	n, err := w.ResponseWriter.Write(p)
+	if err != nil {
+		w.writeFailed = true
+	}
+	return n, err
+}
+
+type gatewayFlushWriter struct {
+	*gatewayResponseWriter
+}
+
+func (w *gatewayFlushWriter) Flush() {
+	_ = w.FlushError()
+}
+
+func (w *gatewayResponseWriter) outputWriter() http.ResponseWriter {
+	if _, ok := w.ResponseWriter.(http.Flusher); ok {
+		return &gatewayFlushWriter{gatewayResponseWriter: w}
+	}
+	if _, ok := w.ResponseWriter.(interface{ FlushError() error }); ok {
+		return &gatewayFlushWriter{gatewayResponseWriter: w}
+	}
+	return w
+}
+
+func (w *gatewayResponseWriter) FlushError() error {
+	return w.flush()
+}
+
+func (w *gatewayResponseWriter) flush() error {
+	if w.status == 0 {
+		w.WriteHeader(http.StatusOK)
+	}
+	err := http.NewResponseController(w.ResponseWriter).Flush()
+	if errors.Is(err, http.ErrNotSupported) {
+		w.deliveryUnknown = true
+		return err
+	}
+	if err != nil {
+		w.writeFailed = true
+	}
+	return err
+}
+
+func (w *gatewayResponseWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+
+func gatewayLifecycleAttrs(r *http.Request, requestID string, stage string, status int, elapsedMS int64, outcome string) []any {
+	attrs := []any{"event", "gateway_request_" + stage, "gateway_request_id", requestID, "gateway_instance_id", gatewayInstanceID, "stage", stage, "http_status", status, "elapsed_ms", elapsedMS}
+	if build := os.Getenv("RAILWAY_GIT_COMMIT_SHA"); buildIDPattern.MatchString(build) {
+		attrs = append(attrs, "gateway_build_id", build)
+	} else if id, err := uuid.Parse(os.Getenv("RAILWAY_DEPLOYMENT_ID")); err == nil {
+		attrs = append(attrs, "gateway_build_id", id.String())
+	} else {
+		attrs = append(attrs, "gateway_build_id", "unknown")
+	}
+	for _, header := range []struct{ name, key string }{
+		{headerJobID, "job_id"}, {headerAttemptID, "attempt_id"}, {headerRequestID, "request_id"},
+	} {
+		if id, err := uuid.Parse(r.Header.Get(header.name)); err == nil {
+			attrs = append(attrs, header.key, id.String())
+		}
+	}
+	if attempt := r.Header.Get(headerTransportAttempt); attempt == "1" || attempt == "2" {
+		attrs = append(attrs, "transport_attempt", attempt)
+	}
+	if outcome != "" {
+		attrs = append(attrs, "downstream_delivery_outcome", outcome)
+	}
+	return attrs
+}
+
+func beginGatewayLifecycle(w http.ResponseWriter, r *http.Request) (*gatewayResponseWriter, string, time.Time) {
+	requestID := uuid.NewString()
+	w.Header().Set(headerGatewayRequestID, requestID)
+	wrapped := &gatewayResponseWriter{ResponseWriter: w}
+	started := time.Now()
+	slog.Info("gateway request started", gatewayLifecycleAttrs(r, requestID, "started", 0, 0, "")...)
+	return wrapped, requestID, started
+}
+
+func logGatewayRequestRejected(r *http.Request, requestID string, stage string, status int) {
+	attrs := gatewayLifecycleAttrs(r, requestID, stage, status, 0, "")
+	attrs[1] = "gateway_request_rejected"
+	attrs = append(attrs, "upstream_call", false)
+	slog.Info("gateway request rejected", attrs...)
+}
+
+func endGatewayLifecycle(w *gatewayResponseWriter, r *http.Request, requestID string, started time.Time) {
+	status := w.status
+	if status == 0 {
+		status = http.StatusOK
+	}
+	outcome := "completed"
+	if w.writeFailed {
+		outcome = "write_failed"
+	} else if w.deliveryUnknown {
+		outcome = "unknown"
+	}
+	attrs := gatewayLifecycleAttrs(r, requestID, "ended", status, time.Since(started).Milliseconds(), outcome)
+	if w.writeFailed && r.Context().Err() != nil {
+		attrs = append(attrs, "cancellation_origin", "unknown")
+	}
+	slog.Info("gateway request ended", attrs...)
+}
diff --git a/internal/httpserver/diagnostics_test.go b/internal/httpserver/diagnostics_test.go
new file mode 100644
index 0000000..36495eb
--- /dev/null
+++ b/internal/httpserver/diagnostics_test.go
@@ -0,0 +1,119 @@
+package httpserver
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+type failingDiagnosticWriter struct {
+	header http.Header
+}
+
+func (w *failingDiagnosticWriter) Header() http.Header { return w.header }
+func (w *failingDiagnosticWriter) WriteHeader(int)     {}
+func (w *failingDiagnosticWriter) Write([]byte) (int, error) {
+	return 0, errors.New("private downstream body")
+}
+
+func TestGatewayLifecycleSeparatesWriteFailureFromCancellation(t *testing.T) {
+	var logs bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&logs, nil)))
+	t.Cleanup(func() { slog.SetDefault(previous) })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	r := httptest.NewRequest(http.MethodPost, "/r/private-route/v1/chat/completions", nil).WithContext(ctx)
+	r.Header.Set(headerJobID, "123e4567-e89b-12d3-a456-426614174000")
+	w, id, started := beginGatewayLifecycle(&failingDiagnosticWriter{header: make(http.Header)}, r)
+	cancel()
+	_, _ = w.Write([]byte("private downstream body"))
+	endGatewayLifecycle(w, r, id, started.Add(-time.Millisecond))
+	if !strings.Contains(logs.String(), `"downstream_delivery_outcome":"write_failed"`) || !strings.Contains(logs.String(), `"cancellation_origin":"unknown"`) || strings.Contains(logs.String(), "private downstream body") || strings.Contains(logs.String(), "private-route") {
+		t.Fatal("write failure lifecycle log was incomplete or included request data")
+	}
+}
+
+func TestCompletedGatewayWriteIsNotRelabeledByReaderCancellation(t *testing.T) {
+	var logs bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&logs, nil)))
+	t.Cleanup(func() { slog.SetDefault(previous) })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	r := httptest.NewRequest(http.MethodPost, "/r/route/v1/chat/completions", nil).WithContext(ctx)
+	w := httptest.NewRecorder()
+	tracked, id, started := beginGatewayLifecycle(w, r)
+	if _, err := tracked.Write([]byte("ok")); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	endGatewayLifecycle(tracked, r, id, started)
+	if !strings.Contains(logs.String(), `"downstream_delivery_outcome":"completed"`) || strings.Contains(logs.String(), `"downstream_delivery_outcome":"cancelled"`) {
+		t.Fatal("successful delivery was mislabeled after reader cancellation")
+	}
+}
+
+type noFlushDiagnosticWriter struct {
+	header http.Header
+}
+
+func (w *noFlushDiagnosticWriter) Header() http.Header         { return w.header }
+func (w *noFlushDiagnosticWriter) WriteHeader(int)             {}
+func (w *noFlushDiagnosticWriter) Write(p []byte) (int, error) { return len(p), nil }
+
+type flushErrorDiagnosticWriter struct {
+	header http.Header
+}
+
+func (w *flushErrorDiagnosticWriter) Header() http.Header         { return w.header }
+func (w *flushErrorDiagnosticWriter) WriteHeader(int)             {}
+func (w *flushErrorDiagnosticWriter) Write(p []byte) (int, error) { return len(p), nil }
+func (w *flushErrorDiagnosticWriter) FlushError() error           { return errors.New("private flush failure") }
+
+func TestGatewayLifecycleRecordsUnderlyingFlushError(t *testing.T) {
+	var logs bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&logs, nil)))
+	t.Cleanup(func() { slog.SetDefault(previous) })
+
+	r := httptest.NewRequest(http.MethodPost, "/r/route/v1/chat/completions", nil)
+	writer := &flushErrorDiagnosticWriter{header: make(http.Header)}
+	tracked, id, started := beginGatewayLifecycle(writer, r)
+	if _, err := tracked.Write([]byte("ok")); err != nil {
+		t.Fatal(err)
+	}
+	tracked.outputWriter().(http.Flusher).Flush()
+	endGatewayLifecycle(tracked, r, id, started)
+	if !strings.Contains(logs.String(), `"downstream_delivery_outcome":"write_failed"`) || strings.Contains(logs.String(), "private flush failure") {
+		t.Fatal("underlying flush failure was not safely recorded")
+	}
+}
+
+func TestGatewayLifecycleMarksUnsupportedFlushAsUnknown(t *testing.T) {
