+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestSportsDeskAcceptedExecutionNeverRetries(t *testing.T) {
+	for _, tc := range []struct {
+		name                    string
+		timeout, timeToComplete time.Duration
+		want                    string
+		http2                   bool
+	}{
+		{"after_former_budget", 300 * time.Millisecond, 80 * time.Millisecond, "completed", false},
+		{"new_deadline", 40 * time.Millisecond, 150 * time.Millisecond, "upstream_timeout", false},
+		{"missing_terminal", 300 * time.Millisecond, 0, "upstream_eof", false},
+		{"http2_completed", 300 * time.Millisecond, 30 * time.Millisecond, "completed", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var calls atomic.Int32
+			up := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls.Add(1)
+				var input map[string]any
+				json.NewDecoder(r.Body).Decode(&input)
+				if input["reasoning"].(map[string]any)["effort"] != "xhigh" || input["tools"].([]any)[0].(map[string]any)["external_web_access"] != true {
+					t.Error("request semantics lost")
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				w.Header().Set("X-Request-Id", "req_safe_123")
+				io.WriteString(w, "data: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_local\"}}\n\n")
+				w.(http.Flusher).Flush()
+				if tc.timeToComplete == 0 {
+					return
+				}
+				select {
+				case <-r.Context().Done():
+					return
+				case <-time.After(tc.timeToComplete):
+				}
+				io.WriteString(w, "data: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"web_search_call\",\"id\":\"search_1\",\"status\":\"completed\",\"action\":{\"type\":\"search\",\"sources\":[{\"url\":\"https://example.org/source\"}]}}}\n\n")
+				io.WriteString(w, "data: {\"type\":\"response.output_text.delta\",\"delta\":\"result\"}\n\n")
+				io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_local\",\"reasoning\":{\"effort\":\"xhigh\"}}}\n\n")
+				w.(http.Flusher).Flush()
+				<-r.Context().Done() // terminal must finish without waiting for EOF
+			}))
+			if tc.http2 {
+				up.EnableHTTP2 = true
+				up.StartTLS()
+			} else {
+				up.Start()
+			}
+			defer up.Close()
+			sec := memory.New()
+			accounts := []store.Account{}
+			for i := 0; i < 2; i++ {
+				id := uuid.New()
+				path := vendor.InfisicalPath(uuid.New().String(), "codex", "local")
+				sec.Put(context.Background(), path, vendor.SecretName, mustJSON(secrets.CredentialJSON{AccessToken: "local-test-token"}))
+				accounts = append(accounts, store.Account{ID: id, InfisicalPath: path, BaseURL: up.URL, Vendor: "codex", AuthType: "oauth", Weight: 1, Position: i})
+			}
+			st := &memRouteStore{accounts: accounts, cool: map[uuid.UUID]time.Time{}}
+			client := up.Client()
+			client.Timeout = tc.timeout
+			eng := &proxy.Engine{Store: st, Secrets: sec, HTTP: client, Selector: router.NewSelector()}
+			rt := &store.Route{ID: uuid.New(), Strategy: string(router.Sequential)}
+			res, err := eng.ChatCompletions(context.Background(), uuid.New(), rt, []byte(`{"model":"gpt-6-astra","reasoning_effort":"xhigh","stream":true,"messages":[{"role":"user","content":"local"}],"tools":[{"type":"function","function":{"name":"web_search"}}],"tool_choice":"required","llms":{"web_search":{"mode":"live"}}}`), proxy.DispatchMeta{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if res.Stream == nil {
+				t.Fatalf("no stream: %s", res.Error)
+			}
+			body, err := io.ReadAll(res.Stream)
+			res.Stream.Close()
+			if err != nil {
+				t.Fatal(err)
+			}
+			protocol := "HTTP/1.1"
+			if tc.http2 {
+				protocol = "HTTP/2.0"
+			}
+			if !strings.Contains(string(body), protocol) || !strings.Contains(string(body), "req_safe_123") {
+				t.Fatalf("HTTP diagnostics missing: %s", body)
+			}
+			if calls.Load() != 1 || res.Attempts != 1 {
+				t.Fatalf("execution replayed calls=%d attempts=%d", calls.Load(), res.Attempts)
+			}
+			if !strings.Contains(string(body), tc.want) || !strings.Contains(string(body), "resp_local") {
+				t.Fatalf("terminal: %s", body)
+			}
+			if tc.want == "completed" && (!strings.Contains(string(body), "https://example.org/source") || !strings.Contains(string(body), "xhigh")) {
+				t.Fatalf("metadata lost: %s", body)
+			}
+		})
+	}
+}
