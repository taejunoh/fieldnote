diff --git a/internal/proxy/codex_diagnostics.go b/internal/proxy/codex_diagnostics.go
new file mode 100644
index 0000000..12825d0
--- /dev/null
+++ b/internal/proxy/codex_diagnostics.go
@@ -0,0 +1,229 @@
+package proxy
+
+import (
+	"bufio"
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"net"
+	"syscall"
+
+	"github.com/google/uuid"
+)
+
+func codexSafeDiagnostics(state *codexParseState) map[string]any {
+	if state == nil {
+		return nil
+	}
+	stage := state.transportStage
+	if stage == "" {
+		stage = "upstream_read"
+	}
+	root := safeCodexRootCause(state)
+	out := map[string]any{
+		"schema_version": 1,
+		"stage":          stage,
+		"event_count":    state.eventCount,
+	}
+	if id, err := uuid.Parse(state.gatewayRequestID); err == nil {
+		out["gateway_request_id"] = id.String()
+	}
+	if state.upstreamTransport == "http" || state.upstreamTransport == "ws" {
+		out["upstream_transport"] = state.upstreamTransport
+	}
+	switch state.terminalStatus {
+	case "completed", "failed", "incomplete", "interrupted":
+		out["upstream_terminal_status"] = state.terminalStatus
+	}
+	if state.upstreamProtocol != "" {
+		out["upstream_http_protocol"] = state.upstreamProtocol
+	}
+	if safeCodexIdentifier(state.requestID) {
+		out["upstream_request_id"] = state.requestID
+	}
+	if state.upstreamID != "" && len(state.upstreamID) <= 128 && safeCodexIdentifier(state.upstreamID) {
+		out["upstream_response_id"] = state.upstreamID
+	}
+	if !state.startedAt.IsZero() && !state.finishedAt.IsZero() {
+		out["elapsed_ms"] = boundedElapsedMS(state.finishedAt, state.startedAt)
+	}
+	if !state.lastEventAt.IsZero() {
+		out["last_event_at"] = state.lastEventAt.UTC().Format("2006-01-02T15:04:05.000Z")
+		out["last_event_age_ms"] = boundedElapsedMS(state.finishedAt, state.lastEventAt)
+	}
+	if state.lastEventType != "" {
+		out["last_event_type"] = safeCodexEventType(state.lastEventType)
+	}
+	if state.upstreamHTTPStatus >= 100 && state.upstreamHTTPStatus <= 599 {
+		out["upstream_http_status"] = state.upstreamHTTPStatus
+	}
+	if state.websocketCloseObserved {
+		out["close_frame_received"] = true
+		if state.websocketCloseCode >= 1000 && state.websocketCloseCode <= 4999 {
+			out["websocket_close_code"] = state.websocketCloseCode
+		}
+	}
+	if state.websocketMessageTooBig {
+		out["websocket_message_too_big"] = true
+	}
+	if state.websocketProtocolError {
+		out["websocket_protocol_error"] = true
+	}
+	if state.transportErr != nil || state.upstreamHTTPStatus >= 400 || state.websocketCloseObserved {
+		chain := safeCodexCauseChain(state.transportErr)
+		if len(chain) > 0 {
+			out["cause_chain"] = chain
+		}
+		origin := "gateway_upstream"
+		if stage == "downstream_write" {
+			origin = "gateway_downstream"
+		}
+		out["error_origin"] = origin
+		out["root_cause"] = root
+		out["safe_message_code"] = root
+		fingerprintInput := map[string]any{"stage": stage, "root_cause": root}
+		if len(chain) > 0 {
+			fingerprintInput["cause_chain"] = chain
+		}
+		if data, err := json.Marshal(fingerprintInput); err == nil {
+			sum := sha256.Sum256(data)
+			out["error_fingerprint"] = hex.EncodeToString(sum[:])
+		}
+	}
+	return out
+}
+
+func safeCodexRootCause(state *codexParseState) string {
+	if state.websocketMessageTooBig {
+		return "message_too_big"
+	}
+	if state.websocketProtocolError {
+		return "protocol_error"
+	}
+	if state.upstreamHTTPStatus >= 400 {
+		return "http_rejected"
+	}
+	if state.websocketCloseObserved {
+		return "websocket_close"
+	}
+	if state.transportErr != nil {
+		var dnsErr *net.DNSError
+		if errors.As(state.transportErr, &dnsErr) {
+			return "dns_error"
+		}
+		var verifyErr *tls.CertificateVerificationError
+		var unknownAuthority x509.UnknownAuthorityError
+		var hostnameErr x509.HostnameError
+		var invalidCert x509.CertificateInvalidError
+		if errors.As(state.transportErr, &verifyErr) || errors.As(state.transportErr, &unknownAuthority) || errors.As(state.transportErr, &hostnameErr) || errors.As(state.transportErr, &invalidCert) {
+			return "tls_error"
+		}
+		if errors.Is(state.transportErr, syscall.ECONNREFUSED) {
+			return "connection_refused"
+		}
+	}
+	if isCodexRootCause(state.transportErrorKind) {
+		return state.transportErrorKind
+	}
+	return "unknown"
+}
+
+func safeCodexCauseChain(err error) []map[string]string {
+	chain := make([]map[string]string, 0, 4)
+	for depth := 0; err != nil && depth < 4; depth++ {
+		kind, code := codexCauseCode(err)
+		entry := map[string]string{"type": kind}
+		if code != "" {
+			entry["code"] = code
+		}
+		chain = append(chain, entry)
+		err = errors.Unwrap(err)
+	}
+	return chain
+}
+
+func codexCauseCode(err error) (string, string) {
+	switch {
+	case errors.Is(err, context.DeadlineExceeded):
+		return "context", "DEADLINE_EXCEEDED"
+	case errors.Is(err, context.Canceled):
+		return "context", "CONTEXT_CANCELED"
+	case errors.Is(err, io.ErrUnexpectedEOF):
+		return "eof", "UNEXPECTED_EOF"
+	case errors.Is(err, io.EOF):
+		return "eof", "EOF"
+	case errors.Is(err, syscall.ECONNRESET):
+		return "syscall", "ECONNRESET"
+	case errors.Is(err, syscall.ECONNABORTED):
+		return "syscall", "ECONNABORTED"
+	case errors.Is(err, syscall.ECONNREFUSED):
+		return "syscall", "ECONNREFUSED"
+	case errors.Is(err, syscall.EPIPE):
+		return "syscall", "EPIPE"
+	case errors.Is(err, syscall.ETIMEDOUT):
+		return "syscall", "ETIMEDOUT"
+	case errors.Is(err, bufio.ErrTooLong):
+		return "scanner", "SCANNER_TOO_LONG"
+	}
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) {
+		if dnsErr.IsNotFound {
+			return "dns", "ENOTFOUND"
+		}
+		if dnsErr.IsTemporary {
+			return "dns", "EAI_AGAIN"
+		}
+		return "dns", ""
+	}
+	var verifyErr *tls.CertificateVerificationError
+	var unknownAuthority x509.UnknownAuthorityError
+	var hostnameErr x509.HostnameError
+	var invalidCert x509.CertificateInvalidError
+	if errors.As(err, &verifyErr) || errors.As(err, &unknownAuthority) || errors.As(err, &hostnameErr) || errors.As(err, &invalidCert) {
+		return "tls", ""
+	}
+	var opErr *net.OpError
+	if errors.As(err, &opErr) {
+		return "net", ""
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) {
+		return "net", ""
+	}
+	return "unknown", "UNKNOWN"
+}
+
+func isCodexRootCause(value string) bool {
+	switch value {
+	case "deadline_exceeded", "context_cancelled", "unexpected_eof", "connection_reset", "connection_closed", "connection_refused", "dns_error", "tls_error", "http_rejected", "websocket_close", "message_too_big", "protocol_error", "json_error", "scanner_token_too_long", "unknown":
+		return true
+	default:
+		return false
+	}
