--- /dev/null
+++ b/internal/store/sqlite_time_test.go
@@ -0,0 +1,18 @@
+package store
+
+import (
+	"testing"
+	"time"
+)
+
+func TestFlexibleTimeScansSQLiteUTCWithLowercaseZone(t *testing.T) {
+	var got time.Time
+	err := (&flexibleTime{dest: &got}).Scan("2026-09-29 20:38:24 +0000 utc")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := time.Date(2026, 9, 29, 20, 38, 24, 0, time.UTC)
+	if !got.Equal(want) {
+		t.Fatalf("got %s, want %s", got.Format(time.RFC3339Nano), want.Format(time.RFC3339Nano))
+	}
+}
