+func TestSportsDeskQuotaExhaustedOnlyFromFreshCodexUsage(t *testing.T) {
+	now := time.Now().UTC()
+	zero, available := 0.0, 20.0
+	reset := now.Add(90 * time.Minute)
+	fresh := now.Add(-time.Minute)
+	stale := now.Add(-30 * time.Minute)
+	cases := []struct {
+		name     string
+		accounts []store.Account
+		want     string
+	}{
+		{"fresh depleted Codex seats", []store.Account{{ID: uuid.New(), Vendor: "codex", AuthType: "oauth", QuotaUpdatedAt: &fresh, Quota5hRemainingPct: &zero, Quota5hResetAt: &reset}, {ID: uuid.New(), Vendor: "codex", AuthType: "oauth", QuotaUpdatedAt: &fresh, Quota7dRemainingPct: &zero, Quota7dResetAt: &reset}}, "quota_exhausted"},
+		{"transient 429 cooldown", []store.Account{{ID: uuid.New(), Vendor: "codex", AuthType: "oauth", QuotaUpdatedAt: &fresh, Quota5hRemainingPct: &available, Quota5hResetAt: &reset}}, "no_usable_accounts"},
+		{"stale depleted usage", []store.Account{{ID: uuid.New(), Vendor: "codex", AuthType: "oauth", QuotaUpdatedAt: &stale, Quota5hRemainingPct: &zero, Quota5hResetAt: &reset}}, "no_usable_accounts"},
+		{"unknown seat", []store.Account{{ID: uuid.New(), Vendor: "codex", AuthType: "oauth"}}, "no_usable_accounts"},
+		{"mixed route", []store.Account{{ID: uuid.New(), Vendor: "codex", AuthType: "oauth", QuotaUpdatedAt: &fresh, Quota5hRemainingPct: &zero, Quota5hResetAt: &reset}, {ID: uuid.New(), Vendor: "openai", AuthType: "api_key"}}, "no_usable_accounts"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			st := &memRouteStore{accounts: tc.accounts, cool: map[uuid.UUID]time.Time{}}
+			for _, a := range tc.accounts {
+				st.cool[a.ID] = now.Add(time.Minute)
+			}
+			rt := &store.Route{ID: uuid.New(), ProjectID: uuid.New(), Slug: "sports", Strategy: "sequential"}
+			eng := &proxy.Engine{Store: st}
+			res, err := eng.ChatCompletions(context.Background(), rt.ProjectID, rt, []byte(`{"model":"gpt-6-astra","messages":[]}`), proxy.DispatchMeta{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if res.Error != tc.want {
+				t.Fatalf("got error=%s body=%s", res.Error, res.Body)
+			}
+			var body map[string]any
+			if err := json.Unmarshal(res.Body, &body); err != nil {
+				t.Fatal(err)
+			}
+			if body["error"] != tc.want {
+				t.Fatalf("body=%s", res.Body)
+			}
+			if tc.want == "quota_exhausted" && body["reset_at"] == nil {
+				t.Fatalf("missing reset_at: %s", res.Body)
+			}
+		})
+	}
+}
