+}
+
+func TestSportsDeskDiagnosticContextAndBounds(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	opts := testBridgeOpts("gpt-6-astra", "chat_1")
+	opts.requestContext = ctx
+	opts.startedAt = time.Now().Add(-48 * time.Hour)
+	opts.upstreamProtocol = "HTTP/2.0"
+	opts.requestID = "req_safe-123"
+	body, _, _, err := aggregateCodexSSE(strings.NewReader(""), opts)
