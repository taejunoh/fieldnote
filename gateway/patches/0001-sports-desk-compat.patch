@@ -0,0 +1,64 @@
+package main
+
+import (
+	"context"
+	"github.com/goodtekxyz/openllms/internal/config"
+	"github.com/goodtekxyz/openllms/internal/db"
+	"github.com/goodtekxyz/openllms/internal/store"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestWebSocketProbeExistingReadOnlyStore(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "probe.db")
+	databaseURL := "sqlite://" + path
+	if err := db.Migrate(databaseURL); err != nil {
+		t.Fatal(err)
+	}
+	conn, err := db.ConnectSQLite(context.Background(), databaseURL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	st := store.NewSQLiteWithCacheTTL(conn, 0, 0)
+	projectID, _, err := st.Bootstrap(context.Background(), "local-probe", "local-probe", "local-probe")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// An untrusted target must be rejected without opening/creating the secret vault.
+	_, err = st.CreateAccount(context.Background(), projectID, "codex", "probe", "oauth", "/local/probe", "https://evil.invalid/backend-api/codex")
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	vault := filepath.Join(root, "missing-secrets")
+	result := probeStoredCodexAccount(config.Config{DatabaseURL: databaseURL, SecretsDir: vault})
+	if result.ErrorCode != "unsafe_target" {
+		t.Fatalf("unsafe result: %+v", result)
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(before) != string(after) {
+		t.Fatal("probe changed database")
+	}
+	if _, err := os.Stat(vault); !os.IsNotExist(err) {
+		t.Fatal("probe created vault")
+	}
+}
+func TestWebSocketProbeNeverCreatesMissingStore(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "missing.db")
+	result := probeStoredCodexAccount(config.Config{DatabaseURL: "sqlite://" + path})
+	if result.ErrorCode != "storage_error" {
+		t.Fatal("missing store accepted")
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatal("probe created store")
+	}
+}
