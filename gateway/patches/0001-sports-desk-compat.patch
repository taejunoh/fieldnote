+package proxy
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"strings"
+	"testing"
+)
+
+type sportsErrorReader struct {
+	io.Reader
+	err error
+}
+
+func (r sportsErrorReader) Read(p []byte) (int, error) {
+	n, e := r.Reader.Read(p)
+	if e == io.EOF {
+		return n, r.err
+	}
+	return n, e
+}
+func TestSportsDeskInterruptedTransportTerminal(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		err  error
+		code string
+	}{
+		{"deadline", context.DeadlineExceeded, "upstream_timeout"},
+		{"transport", io.ErrUnexpectedEOF, "upstream_transport_error"},
+		{"eof", io.EOF, "upstream_eof"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := sportsErrorReader{strings.NewReader("data: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_early\"}}\n\n"), tc.err}
+			stream := startCodexChatPipe(io.NopCloser(r), testBridgeOpts("gpt-6-astra", "chat_1"))
+			out, retryable, err := awaitCommit(stream)
+			if err != nil || retryable {
+				t.Fatalf("accepted execution retried: %v %v", retryable, err)
+			}
+			defer out.Close()
+			body, err := io.ReadAll(out)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !strings.Contains(string(body), tc.code) || !strings.Contains(string(body), "resp_early") || !strings.Contains(string(body), "[DONE]") {
+				t.Fatalf("terminal missing: %s", body)
+			}
+		})
+	}
+}
+func TestSportsDeskCompletedStopsBeforeReadError(t *testing.T) {
+	r := sportsErrorReader{strings.NewReader("data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_ok\"}}\n\n"), io.ErrUnexpectedEOF}
+	body, _, _, err := aggregateCodexSSE(r, testBridgeOpts("gpt-6-astra", "chat_1"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var obj map[string]any
+	json.Unmarshal(body, &obj)
+	if obj["llms"].(map[string]any)["terminal"].(map[string]any)["status"] != "completed" {
+		t.Fatalf("terminal: %s", body)
+	}
+}
+
+func TestSportsDeskExplicitTerminalPreservedWithoutUnsafeError(t *testing.T) {
+	for _, status := range []string{"failed", "incomplete", "cancelled"} {
+		t.Run(status, func(t *testing.T) {
+			event := `data: {"type":"response.` + status + `","response":{"id":"resp_explicit","error":{"code":"server_error","message":"secret-credential","payload":"secret-payload"}}}` + "\n\n"
+			body, _, _, err := aggregateCodexSSE(strings.NewReader(event), testBridgeOpts("gpt-6-astra", "chat_1"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var obj map[string]any
+			json.Unmarshal(body, &obj)
+			terminal := obj["llms"].(map[string]any)["terminal"].(map[string]any)
+			if terminal["status"] != status || terminal["error"].(map[string]any)["code"] != "server_error" || strings.Contains(string(body), "secret-") {
+				t.Fatalf("unsafe terminal: %s", body)
+			}
+		})
+	}
+}
