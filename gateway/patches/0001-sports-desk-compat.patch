+func TestSportsDeskSafeTransportDiagnostics(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		err  error
+		kind string
+	}{
+		{"deadline", context.DeadlineExceeded, "deadline_exceeded"},
+		{"cancelled", context.Canceled, "context_cancelled"},
+		{"unexpected_eof", io.ErrUnexpectedEOF, "unexpected_eof"},
+		{"wrapped_eof", fmt.Errorf("read wrapper: %w", io.EOF), "unexpected_eof"},
+		{"reset", syscall.ECONNRESET, "connection_reset"},
+		{"wrapped_reset", fmt.Errorf("secret-auth-token: %w", syscall.ECONNRESET), "connection_reset"},
+		{"closed", net.ErrClosed, "connection_closed"},
+		{"scanner", bufio.ErrTooLong, "scanner_token_too_long"},
+		{"unknown", errors.New("secret-auth-token https://private.invalid"), "unknown_transport_error"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			body, _, _, err := aggregateCodexSSE(sportsErrorReader{strings.NewReader("data: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_diag\"}}\n\n"), tc.err}, testBridgeOpts("gpt-6-astra", "chat_1"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var obj map[string]any
+			json.Unmarshal(body, &obj)
+			terminal := obj["llms"].(map[string]any)["terminal"].(map[string]any)
+			if terminal["transport_error_kind"] != tc.kind || terminal["event_count"] != float64(1) {
+				t.Fatalf("diagnostics: %s", body)
+			}
+			diagnosticSubset, ok := terminal["diagnostics"].(map[string]any)
+			if !ok || diagnosticSubset["schema_version"] != float64(1) || diagnosticSubset["stage"] != "upstream_read" {
+				t.Fatalf("safe transport subset missing: %s", body)
+			}
+			if fingerprint, ok := diagnosticSubset["error_fingerprint"].(string); !ok || len(fingerprint) != 64 {
+				t.Fatalf("safe error fingerprint missing: %s", body)
+			}
+			for _, key := range []string{"upstream_elapsed_ms", "last_event_age_ms"} {
+				if value, ok := terminal[key].(float64); !ok || value < 0 || value > 86400000 {
+					t.Fatalf("unbounded %s: %s", key, body)
+				}
+			}
+			if strings.Contains(string(body), "secret-auth") || strings.Contains(string(body), "private.invalid") {
+				t.Fatal("raw error leaked")
+			}
+		})
+	}
+}
