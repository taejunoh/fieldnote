+func TestSportsDeskWebSocketSingleCreateAndParity(t *testing.T) {
+	for _, tc := range []struct{ name, want string }{
+		{"completed_open", "completed"}, {"aggregate_completed", "completed"}, {"parallel_missing_terminal", "upstream_eof"}, {"completed_closed", "completed"}, {"missing_terminal", "upstream_eof"}, {"deadline", "upstream_timeout"}, {"closed_after_create", "interrupted"}, {"explicit_error", "failed"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var handshakes, creates, httpPosts atomic.Int32
+			up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != "GET" {
+					httpPosts.Add(1)
+					http.Error(w, "HTTP fallback", 400)
+					return
+				}
+				handshakes.Add(1)
+				if r.Header.Get("Authorization") != "Bearer local-ws-test" || r.Header.Get("ChatGPT-Account-Id") != "local-account" || r.Header.Get("OpenAI-Beta") != "responses_websockets=2026-02-06" {
+					t.Error("WS authentication changed")
+				}
+				w.Header().Set("X-Request-Id", "req_ws_safe")
+				conn, err := websocket.Accept(w, r, nil)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				defer conn.CloseNow()
+				ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+				defer cancel()
+				_, payload, err := conn.Read(ctx)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				creates.Add(1)
+				var got map[string]any
+				json.Unmarshal(payload, &got)
+				if got["type"] != "response.create" || got["model"] != "gpt-6-astra" || got["stream"] != true || got["reasoning"].(map[string]any)["effort"] != "xhigh" || got["tool_choice"].(map[string]any)["type"] != "web_search" || got["include"].([]any)[0] != "web_search_call.action.sources" || got["tools"].([]any)[0].(map[string]any)["external_web_access"] != true || !strings.Contains(string(payload), "full-context-marker") {
+					t.Fatalf("create semantics: %s", payload)
+				}
+				if tc.name == "closed_after_create" {
+					return
+				}
+				conn.Write(ctx, websocket.MessageText, []byte(`{"type":"response.created","response":{"id":"resp_ws"}}`))
+				if tc.name == "deadline" {
+					conn.Read(ctx)
+					return
+				}
+				if tc.name == "missing_terminal" || tc.name == "parallel_missing_terminal" {
+					conn.Close(websocket.StatusNormalClosure, "")
+					return
+				}
+				if tc.name == "explicit_error" {
+					conn.Write(ctx, websocket.MessageText, []byte(`{"type":"error","code":"server_error","message":"secret-message"}`))
+					conn.Read(ctx)
+					return
+				}
+				conn.Write(ctx, websocket.MessageText, []byte(`{"type":"response.output_item.done","item":{"id":"search_ws","type":"web_search_call","status":"completed","action":{"type":"search","sources":[{"url":"https://example.org/ws-source"}]}}}`))
+				conn.Write(ctx, websocket.MessageText, []byte("{\n\"type\":\"response.completed\",\"response\":{\"id\":\"resp_ws\",\"reasoning\":{\"effort\":\"xhigh\"},\"output\":[{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"result\"}]}]}}"))
+				if tc.name == "completed_closed" {
+					conn.Close(websocket.StatusNormalClosure, "")
+					return
+				}
+				conn.Read(ctx) // completed must close promptly without waiting for EOF
+			}))
+			defer up.Close()
+			sec := memory.New()
+			accounts := []store.Account{}
+			for i := 0; i < 2; i++ {
+				id := uuid.New()
+				path := vendor.InfisicalPath(uuid.New().String(), "codex", "local-ws")
+				sec.Put(context.Background(), path, vendor.SecretName, mustJSON(secrets.CredentialJSON{AccessToken: "local-ws-test", ChatGPTAccountID: "local-account"}))
+				accounts = append(accounts, store.Account{ID: id, InfisicalPath: path, BaseURL: up.URL, Vendor: "codex", AuthType: "oauth", Weight: 1, Position: i})
+			}
+			client := up.Client()
+			client.Timeout = 150 * time.Millisecond
+			eng := &proxy.Engine{Store: &memRouteStore{accounts: accounts, cool: map[uuid.UUID]time.Time{}}, Secrets: sec, HTTP: client, Selector: router.NewSelector()}
+			eng.CodexTransport = "ws"
+			started := time.Now()
+			rt := &store.Route{ID: uuid.New(), Strategy: string(router.Sequential)}
+			if strings.HasPrefix(tc.name, "parallel") {
+				rt.Strategy = string(router.Parallel)
+				rt.Config = []byte(`{"parallel_allow_oauth":true}`)
+			}
+			requestBody := []byte(`{"model":"gpt-6-astra","reasoning_effort":"xhigh","stream":true,"messages":[{"role":"user","content":"full-context-marker"}],"tools":[{"type":"function","function":{"name":"web_search"}}],"tool_choice":"required","llms":{"web_search":{"mode":"live"}}}`)
+			if tc.name == "aggregate_completed" {
+				requestBody = []byte(strings.Replace(string(requestBody), `"stream":true`, `"stream":false`, 1))
+			}
+			gatewayRequestID := uuid.NewString()
+			res, err := eng.ChatCompletions(proxy.WithGatewayRequestID(context.Background(), gatewayRequestID), uuid.New(), rt, requestBody, proxy.DispatchMeta{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			body := res.Body
+			if tc.name != "aggregate_completed" {
+				if res.Stream == nil {
+					t.Fatalf("no WS stream: %s", res.Error)
+				}
+				body, err = io.ReadAll(res.Stream)
+				res.Stream.Close()
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if creates.Load() != 1 || handshakes.Load() != 1 || httpPosts.Load() != 0 || res.Attempts != 1 {
+				t.Fatalf("replayed execution creates=%d handshakes=%d HTTP=%d attempts=%d", creates.Load(), handshakes.Load(), httpPosts.Load(), res.Attempts)
+			}
+			if !strings.Contains(string(body), tc.want) || !strings.Contains(string(body), `"upstream_transport":"ws"`) || !strings.Contains(string(body), `"gateway_request_id":"`+gatewayRequestID+`"`) || !strings.Contains(string(body), `"schema_version":1`) || strings.Contains(string(body), "secret-message") {
+				t.Fatalf("terminal: %s", body)
+			}
+			if tc.want == "completed" && (time.Since(started) > 100*time.Millisecond || !strings.Contains(string(body), "https://example.org/ws-source")) {
+				t.Fatalf("completion/source delayed or lost: %s", body)
+			}
+		})
+	}
+}
