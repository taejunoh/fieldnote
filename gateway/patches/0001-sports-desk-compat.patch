+		{"incomplete", `{"type":"response.incomplete","response":{"id":"resp_1","status":"incomplete"}}`, "incomplete"},
+		{"failed", `{"type":"response.failed","response":{"id":"resp_1","status":"failed"}}`, "failed"},
+		{"eof", "", "interrupted"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			sse := "data: {\"type\":\"response.output_text.delta\",\"delta\":\"partial\"}\n\n"
+			if tc.event != "" {
+				sse += "data: " + tc.event + "\n\n"
+			}
+			body, _, _, err := aggregateCodexSSE(strings.NewReader(sse), testBridgeOpts("gpt-6-astra", "chat_1"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var parsed map[string]any
+			if err := json.Unmarshal(body, &parsed); err != nil {
+				t.Fatal(err)
+			}
+			meta, _ := parsed["llms"].(map[string]any)
+			if meta["terminal"].(map[string]any)["status"] != tc.want {
