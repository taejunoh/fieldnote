diff --git a/internal/proxy/codex_websocket.go b/internal/proxy/codex_websocket.go
new file mode 100644
index 0000000..649990b
--- /dev/null
+++ b/internal/proxy/codex_websocket.go
@@ -0,0 +1,174 @@
+package proxy
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/coder/websocket"
+	"github.com/goodtekxyz/openllms/internal/store"
+)
+
+// A single connection carries exactly one response.create. Once its write starts,
+// a failure is an interrupted execution, never a reason to replay the request.
+func (e *Engine) execCodexWebSocket(ctx context.Context, acc *store.Account, body []byte, req *http.Request, model string, stream bool, start time.Time) (*Result, error) {
+	var create map[string]any
+	if json.Unmarshal(body, &create) != nil {
+		return nil, errCodexWSMessage
+	}
+	create["type"] = "response.create"
+	payload, err := json.Marshal(create)
+	if err != nil {
+		return nil, errCodexWSMessage
+	}
+	budget := 45 * time.Minute
+	client := http.DefaultClient
+	if e.HTTP != nil {
+		client = e.HTTP
+		if client.Timeout > 0 {
+			budget = client.Timeout
+		}
+	}
+	executionCtx, cancel := context.WithDeadline(ctx, start.Add(budget))
+	// The explicit execution context owns the whole lifetime, including reads.
+	dialClient := *client
+	dialClient.Timeout = 0
+	headers := req.Header.Clone()
+	headers.Set("OpenAI-Beta", "responses_websockets=2026-02-06")
+	conn, handshake, err := websocket.Dial(executionCtx, req.URL.String(), &websocket.DialOptions{HTTPClient: &dialClient, HTTPHeader: headers})
+	if err != nil {
+		cancel()
+		status := http.StatusBadGateway
+		protocol := ""
+		requestID := ""
+		upstreamStatus := 0
+		if handshake != nil {
+			protocol = handshake.Proto
+			requestID = handshake.Header.Get("X-Request-Id")
+			upstreamStatus = handshake.StatusCode
+			if handshake.Body != nil {
+				handshake.Body.Close()
+			}
+			if handshake.StatusCode >= 400 {
+				status = handshake.StatusCode
+			}
+		}
+		diagnosticState := newCodexParseState(codexBridgeOpts{startedAt: start, upstreamTransport: "ws", upstreamProtocol: protocol, requestID: requestID, upstreamHTTPStatus: upstreamStatus, gatewayRequestID: gatewayRequestIDFromContext(ctx)}, nil)
+		diagnosticState.finishedAt = time.Now()
+		diagnosticState.transportStage = "upstream_dial"
+		diagnosticState.transportErr = err
+		diagnosticState.transportErrorKind = codexTransportErrorKind(err)
+		if diagnosticState.gatewayRequestID != "" {
+			logCodexTerminalDiagnostics(diagnosticState)
+		}
+		return &Result{StatusCode: status, Error: "codex_websocket_handshake", AccountID: acc.ID, Model: model, Latency: time.Since(start)}, nil
+	}
+	conn.SetReadLimit(8 * 1024 * 1024)
+	upstream := startCodexWSCreate(executionCtx, cancel, conn, payload)
+	opts := codexBridgeOpts{model: model, id: "chatcmpl-" + acc.ID.String()[:8], accountID: acc.ID.String(), provider: acc.Vendor, startedAt: start, requestContext: ctx, upstreamTransport: "ws", upstreamProtocol: handshake.Proto, requestID: handshake.Header.Get("X-Request-Id"), upstreamHTTPStatus: handshake.StatusCode, gatewayRequestID: gatewayRequestIDFromContext(ctx)}
+	result := &Result{StatusCode: http.StatusOK, AccountID: acc.ID, Model: model, Latency: time.Since(start)}
+	if stream {
+		result.Stream = startCodexChatPipe(upstream, opts)
+		result.Header = http.Header{"Content-Type": []string{"text/event-stream"}}
+		return result, nil
+	}
+	defer upstream.Close()
+	result.Body, result.TokensIn, result.TokensOut, err = aggregateCodexSSE(upstream, opts)
+	result.Header = http.Header{"Content-Type": []string{"application/json"}}
+	return result, err
+}
+
+type codexWSConn interface {
+	Write(context.Context, websocket.MessageType, []byte) error
+	Read(context.Context) (websocket.MessageType, []byte, error)
+	CloseNow() error
+}
+
+type codexWSReader struct {
+	conn               codexWSConn
+	ctx                context.Context
+	cancel             context.CancelFunc
+	pending            []byte
+	initialErr         error
+	createWriteErr     error
+	websocketCloseCode int
+	hasWebSocketClose  bool
+	messageTooBig      bool
+	protocolError      bool
+}
+
+func startCodexWSCreate(ctx context.Context, cancel context.CancelFunc, conn codexWSConn, payload []byte) *codexWSReader {
+	// Even a failed/partial write may have reached the provider. Return a reader
+	// that yields a terminal interruption through the existing bridge.
+	writeErr := conn.Write(ctx, websocket.MessageText, payload)
+	return &codexWSReader{conn: conn, ctx: ctx, cancel: cancel, initialErr: writeErr, createWriteErr: writeErr}
+}
+
+var errCodexWSMessage = io.ErrUnexpectedEOF
+
+func (r *codexWSReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if r.initialErr != nil {
+		err := r.initialErr
+		r.initialErr = nil
+		return 0, err
+	}
+	if len(r.pending) == 0 {
+		typ, payload, err := r.conn.Read(r.ctx)
+		if err != nil {
+			if errors.Is(err, websocket.ErrMessageTooBig) {
+				r.messageTooBig = true
+			}
+			if code := websocket.CloseStatus(err); code != -1 {
+				r.websocketCloseCode = int(code)
+				r.hasWebSocketClose = true
+			}
+			// Normal WebSocket close without response.completed remains interrupted EOF.
+			if websocket.CloseStatus(err) == websocket.StatusNormalClosure || websocket.CloseStatus(err) == websocket.StatusGoingAway {
+				return 0, io.EOF
+			}
+			return 0, err
+		}
+		if typ != websocket.MessageText {
+			r.protocolError = true
+			return 0, errCodexWSMessage
+		}
+		var compact bytes.Buffer
+		if json.Compact(&compact, payload) != nil {
+			r.protocolError = true
+			return 0, errCodexWSMessage
+		}
+		r.pending = append([]byte("data: "), compact.Bytes()...)
+		r.pending = append(r.pending, '\n', '\n')
+	}
+	n := copy(p, r.pending)
+	r.pending = r.pending[n:]
+	return n, nil
+}
+func (r *codexWSReader) Close() error { r.cancel(); return r.conn.CloseNow() }
+
+func (r *codexWSReader) appendTerminalDiagnostics(state *codexParseState) {
+	if r.createWriteErr != nil {
+		state.transportStage = "upstream_create_write"
+		state.transportErr = r.createWriteErr
+		state.transportErrorKind = codexTransportErrorKind(r.createWriteErr)
+	}
+	if r.hasWebSocketClose {
+		state.websocketCloseObserved = true
+		state.websocketCloseCode = r.websocketCloseCode
+	}
+	if r.messageTooBig {
+		state.websocketMessageTooBig = true
+		state.transportErrorKind = "message_too_big"
+	}
+	if r.protocolError {
+		state.websocketProtocolError = true
+		state.transportErrorKind = "protocol_error"
+	}
+}
