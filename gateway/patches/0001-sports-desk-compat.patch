+	opts.requestID = "secret://bad credential"
+	opts.upstreamProtocol = "secret-protocol"
+	body, _, _, _ = aggregateCodexSSE(strings.NewReader(""), opts)
+	if strings.Contains(string(body), "request_id") || strings.Contains(string(body), "upstream_http_protocol") || strings.Contains(string(body), "secret") {
+		t.Fatalf("unsafe header: %s", body)
+	}
+	for _, id := range []string{"", strings.Repeat("a", 129), "id\nheader", "ümlaut", "id.with-dot"} {
+		if safeUpstreamRequestID(id) != "" {
+			t.Fatalf("accepted unsafe id")
+		}
+	}
