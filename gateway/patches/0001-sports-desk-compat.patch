+)
+
+func TestSportsDeskWebSocketCloseAndReadLimitDiagnostics(t *testing.T) {
+	cases := []struct {
+		name          string
+		closeCode     websocket.StatusCode
+		oversize      bool
+		protocolError bool
+		abrupt        bool
+		binaryFrame   bool
+		wantError     string
+	}{
+		{name: "normal_close", closeCode: websocket.StatusNormalClosure, wantError: "upstream_eof"},
+		{name: "going_away", closeCode: websocket.StatusGoingAway, wantError: "upstream_eof"},
+		{name: "internal_error", closeCode: websocket.StatusInternalError, wantError: "upstream_transport_error"},
+		{name: "try_again_later", closeCode: websocket.StatusTryAgainLater, wantError: "upstream_transport_error"},
+		{name: "peer_message_too_big", closeCode: websocket.StatusMessageTooBig, wantError: "upstream_transport_error"},
+		{name: "read_limit", oversize: true, wantError: "upstream_transport_error"},
+		{name: "abrupt_after_delta", abrupt: true, wantError: "upstream_transport_error"},
+		{name: "malformed_protocol", protocolError: true, wantError: "upstream_transport_error"},
+		{name: "binary_frame", protocolError: true, binaryFrame: true, wantError: "upstream_transport_error"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				conn, err := websocket.Accept(w, r, nil)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				defer conn.CloseNow()
+				ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+				defer cancel()
+				if _, _, err := conn.Read(ctx); err != nil {
+					t.Error(err)
+					return
+				}
+				if err := conn.Write(ctx, websocket.MessageText, []byte(`{"type":"response.created","response":{"id":"resp_local"}}`)); err != nil {
+					t.Error(err)
+					return
+				}
+				if tc.abrupt {
+					if err := conn.Write(ctx, websocket.MessageText, []byte(`{"type":"response.output_text.delta","delta":"partial"}`)); err != nil {
+						t.Error(err)
+						return
+					}
+					conn.CloseNow()
+					return
+				}
+				if tc.oversize {
+					if err := conn.Write(ctx, websocket.MessageText, []byte(strings.Repeat("x", 8*1024*1024+1))); err != nil {
+						t.Error(err)
+					}
+					return
+				}
+				if tc.protocolError {
+					typ, payload := websocket.MessageText, []byte("private-malformed-message")
+					if tc.binaryFrame {
+						typ, payload = websocket.MessageBinary, []byte("private-binary-payload")
+					}
+					if err := conn.Write(ctx, typ, payload); err != nil {
+						t.Error(err)
+					}
+					return
+				}
+				if err := conn.Close(tc.closeCode, "private-close-reason"); err != nil {
+					t.Error(err)
+				}
+			}))
+			defer server.Close()
+
+			url := "ws" + strings.TrimPrefix(server.URL, "http")
+			conn, _, err := websocket.Dial(context.Background(), url, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			conn.SetReadLimit(8 * 1024 * 1024)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			reader := startCodexWSCreate(ctx, cancel, conn, []byte(`{"type":"response.create"}`))
+			body, _, _, err := aggregateCodexSSE(reader, testBridgeOpts("gpt-6-astra", "chat_1"))
+			reader.Close()
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			var response map[string]any
+			if err := json.Unmarshal(body, &response); err != nil {
+				t.Fatal(err)
+			}
+			terminal := response["llms"].(map[string]any)["terminal"].(map[string]any)
+			if terminal["status"] != "interrupted" || terminal["error"].(map[string]any)["code"] != tc.wantError {
+				t.Fatalf("terminal: %s", body)
+			}
+			if tc.abrupt && terminal["transport_error_kind"] != "unexpected_eof" {
+				t.Fatalf("abrupt EOF kind: %s", body)
+			}
+			if !tc.oversize && !tc.protocolError && !tc.abrupt && terminal["websocket_close_code"] != float64(tc.closeCode) {
+				t.Fatalf("close code missing: %s", body)
+			}
+			if tc.oversize && terminal["websocket_message_too_big"] != true {
+				t.Fatalf("read-limit diagnostic missing: %s", body)
+			}
+			if !tc.oversize && terminal["websocket_message_too_big"] != nil {
+				t.Fatalf("peer close was mislabeled as local read-limit overflow: %s", body)
+			}
+			if tc.protocolError && terminal["websocket_protocol_error"] != true {
+				t.Fatalf("protocol diagnostic missing: %s", body)
+			}
+			wantLastEvent := "response.created"
+			if tc.abrupt {
+				wantLastEvent = "response.output_text.delta"
+			}
+			if terminal["last_event_type"] != wantLastEvent {
+				t.Fatalf("last event type missing: %s", body)
+			}
+			if strings.Contains(string(body), "private-close-reason") || strings.Contains(string(body), "private-malformed-message") || strings.Contains(string(body), strings.Repeat("x", 32)) {
+				t.Fatalf("private transport text leaked: %s", body)
+			}
+			if !strings.Contains(string(body), "resp_local") {
+				t.Fatalf("response id lost: %s", body)
+			}
+		})
+	}
+}
+
+func TestSafeCodexEventTypeAllowsHostedSearchProgress(t *testing.T) {
+	for _, eventType := range []string{
+		"response.web_search_call.in_progress",
+		"response.web_search_call.searching",
+		"response.web_search_call.completed",
+	} {
+		if got := safeCodexEventType(eventType); got != eventType {
+			t.Errorf("safeCodexEventType(%q) = %q", eventType, got)
+		}
+	}
+	if got := safeCodexEventType("response.web_search_call.private-payload"); got != "other" {
+		t.Errorf("unknown event type should be collapsed, got %q", got)
+	}
+}
