+	}
+	for _, effort := range []string{"low", "max"} {
+		in := []byte(`{"reasoning_effort":"` + effort + `","messages":[{"role":"user","content":"hi"}]}`)
+		if _, _, _, err := chatToCodexResponses(in); err == nil {
