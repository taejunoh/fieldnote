new file mode 100644
index 0000000..421c64c
--- /dev/null
+++ b/internal/proxy/codex_websocket_probe.go
@@ -0,0 +1,65 @@
+package proxy
+
+import (
+	"context"
+	"github.com/coder/websocket"
+	"github.com/goodtekxyz/openllms/internal/store"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+type CodexWebSocketProbe struct {
+	OK         bool   `json:"ok"`
+	HTTPStatus int    `json:"http_status,omitempty"`
+	Protocol   string `json:"http_protocol,omitempty"`
+	ErrorCode  string `json:"error_code,omitempty"`
+}
+
+// CheckCodexWebSocketHandshake performs no refresh or application-message write.
+// It accepts only the official Codex endpoint and never follows redirects.
+func (e *Engine) CheckCodexWebSocketHandshake(ctx context.Context, acc *store.Account) CodexWebSocketProbe {
+	if acc == nil || !strings.EqualFold(acc.Vendor, "codex") || !strings.EqualFold(acc.AuthType, "oauth") {
+		return CodexWebSocketProbe{ErrorCode: "no_eligible_account"}
+	}
+	target, err := url.Parse(resolveResponsesURL(acc))
+	if err != nil || target.Scheme != "https" || target.Host != "chatgpt.com" || target.Path != "/backend-api/codex/responses" || target.RawQuery != "" || target.Fragment != "" || target.User != nil {
+		return CodexWebSocketProbe{ErrorCode: "unsafe_target"}
+	}
+	cred, token, err := e.loadCredential(ctx, acc)
+	if err != nil {
+		return CodexWebSocketProbe{ErrorCode: "secrets_error"}
+	}
+	req, _ := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	applyUpstreamAuth(req, acc, cred, token, true, "Authorization", "Bearer ")
+	req.Header.Set("OpenAI-Beta", "responses_websockets=2026-02-06")
+	client := e.HTTP
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return probeCodexWebSocket(ctx, req, client)
+}
+func probeCodexWebSocket(ctx context.Context, req *http.Request, client *http.Client) CodexWebSocketProbe {
+	ctx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	clientCopy := *client
+	clientCopy.Timeout = 0
+	clientCopy.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	conn, response, err := websocket.Dial(ctx, req.URL.String(), &websocket.DialOptions{HTTPClient: &clientCopy, HTTPHeader: req.Header})
+	result := CodexWebSocketProbe{}
+	if response != nil {
+		result.HTTPStatus = response.StatusCode
+		result.Protocol = safeUpstreamProtocol(response.Proto)
+		if response.Body != nil {
+			response.Body.Close()
+		}
+	}
+	if err != nil {
+		result.ErrorCode = "handshake_failed"
+		return result
+	}
+	conn.CloseNow() // Deliberately no Conn.Write, Ping, or response.create.
+	result.OK = true
+	return result
+}
