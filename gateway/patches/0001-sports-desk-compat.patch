@@ -0,0 +1,72 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"github.com/goodtekxyz/openllms/internal/config"
+	"github.com/goodtekxyz/openllms/internal/db"
+	"github.com/goodtekxyz/openllms/internal/proxy"
+	secretfile "github.com/goodtekxyz/openllms/internal/secrets/file"
+	"github.com/goodtekxyz/openllms/internal/store"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+)
+
+func runCodexWebSocketProbe() int {
+	result := proxy.CodexWebSocketProbe{ErrorCode: "config_error"}
+	cfg, err := config.Load()
+	if err == nil {
+		result = probeStoredCodexAccount(cfg)
+	}
+	json.NewEncoder(os.Stdout).Encode(result)
+	if result.OK {
+		return 0
+	}
+	return 1
+}
+func probeStoredCodexAccount(cfg config.Config) proxy.CodexWebSocketProbe {
+	if !db.IsSQLite(cfg.DatabaseURL) {
+		return proxy.CodexWebSocketProbe{ErrorCode: "unsupported_storage"}
+	}
+	path, err := db.SQLiteFilePath(cfg.DatabaseURL)
+	if err != nil {
+		return proxy.CodexWebSocketProbe{ErrorCode: "storage_error"}
+	}
+	if _, err := os.Stat(path); err != nil {
+		return proxy.CodexWebSocketProbe{ErrorCode: "storage_error"}
+	}
+	// mode=ro avoids migration, journal changes, directory creation, and writes.
+	dsn := (&url.URL{Scheme: "file", Path: path, RawQuery: "mode=ro"}).String()
+	conn, err := sql.Open("sqlite", dsn)
+	if err != nil {
+		return proxy.CodexWebSocketProbe{ErrorCode: "storage_error"}
+	}
+	defer conn.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	st := store.NewSQLiteWithCacheTTL(conn, 0, 0)
+	accounts, err := st.ListOAuthAccounts(ctx)
+	if err != nil {
+		return proxy.CodexWebSocketProbe{ErrorCode: "storage_error"}
+	}
+	var selected *store.Account
+	for i := range accounts {
+		if strings.EqualFold(accounts[i].Vendor, "codex") && accounts[i].Health == "ok" {
+			selected = &accounts[i]
+			break
+		}
+	}
+	if selected == nil {
+		return proxy.CodexWebSocketProbe{ErrorCode: "no_eligible_account"}
+	}
+	secret, err := secretfile.New(cfg.SecretsDir)
+	if err != nil {
+		return proxy.CodexWebSocketProbe{ErrorCode: "secrets_error"}
+	}
+	engine := &proxy.Engine{Secrets: secret, HTTP: &http.Client{Timeout: 15 * time.Second}}
+	return engine.CheckCodexWebSocketHandshake(ctx, selected)
+}
